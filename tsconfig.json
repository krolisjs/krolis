{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "declaration": true,
    "rootDir": "src",
    "declarationDir": "dist",
    "emitDeclarationOnly": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tsbuildinfo",
    "removeComments": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "lib": [
      "dom",
      "webworker",
      "esnext"
    ],
    "types": [
      "@webgpu/types"
    ]
  },
  "exclude": [
    "node_modules",
    "dist",
    "test"
  ],
}
